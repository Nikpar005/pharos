{
  "name": "pharos",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first emergency preparedness app. Works without internet, keeps your data on your phone.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run content && vite",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-size.mjs",
    "check": "npm run content && npm run typecheck && npm test && vite build && npm run size",
    "android": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capawesome/capacitor-torch": "^8.0.2",
    "@protomaps/basemaps": "^5.7.2",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "preact": "^10.29.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikpar005/pharos"
  }
}
